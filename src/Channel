%% PHASE 2: CHANNEL

% Link budget
d_satellite        = 36000e3;
c_speed            = 3e8;
rain_loss_db       = 3.5;
antenna_loss_db    = 1.5;
tx_power_dBW       = 17;
tx_antenna_gain_db = 30;
rx_antenna_gain_db = 40;
f_rf               = 12e9;

% Free space path loss
fspl_db = 20*log10(4*pi*d_satellite*f_rf/c_speed);

% Total losses and total gains
total_loss_db  = fspl_db + rain_loss_db + antenna_loss_db;
total_gain_db  = tx_power_dBW + tx_antenna_gain_db + rx_antenna_gain_db;
Prx_dBW = total_gain_db - total_loss_db;

% The Hiss
k = 1.38e-23;
T_sys_clear = 150;
T_rain_phys = 275;
T_rain = T_rain_phys * (1 - 10^(-rain_loss_db/10));
T_sys = T_sys_clear + T_rain;
Rs = fs/samples_per_symbol;
Rb = 2*Rs;
Eb_N0_dB = Prx_dBW - 10*log10(k*T_sys*Rb);
Eb_N0_lin = 10^(Eb_N0_dB/10);
link_margin_dB = Eb_N0_dB - 9.6;


% Fade the wave by path loss
loss_factor = 10^(-total_loss_db/20);   % voltage factor
faded_wave  = tx_wave * loss_factor;

% Add noise based on link margin
signal_power      = mean(faded_wave.^2);
noise_var         = signal_power * fs / (2 * Rb * Eb_N0_lin) ;
noise             = sqrt(noise_var) * randn(N, 1);
rx_wave           = faded_wave + noise;

% Compute SNR and Eb/N0
SNR_dB    = 10*log10(signal_power / noise_var);

% Plot channel
figure;
subplot(2,1,1);
plot(t(1:100)*1e6, faded_wave(1:100), 'k');
title(sprintf('After %.1f dB Path Loss', total_loss_db)); grid on;

subplot(2,1,2);
plot(t(1:100)*1e6, rx_wave(1:100), 'r');
title(sprintf('Received Signal + Noise | SNR=%.1f dB | Eb/N0=%.1f dB', SNR_dB, Eb_N0_dB));
grid on;
