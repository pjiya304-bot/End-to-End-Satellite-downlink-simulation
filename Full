clear; close all; clc; rand('seed', 1); randn('seed', 1);

%% PARAMETERS
num_bits           = 10000;
phase_offset_deg   = 25;
freq_offset_Hz     = 0;
skip_sym           = 1000;
f_carrier          = 10e6;
fs                 = 100e6;
samples_per_symbol = 10;
impedance          = 50;
span = 6;    % RRC filter span, in symbols
beta = 0.35; % RRC roll off factor

%--- RRC Filter Design ---
% It is built once but used at both the transmitter and receiver
t_rrc = (-span*samples_per_symbol/2: span*samples_per_symbol/2) / samples_per_symbol;
h_rrc = rrc_filter(t_rrc, beta);
h_rrc = h_rrc(:);

%% PHASE 1: TRANSMITTER

% Generate random bits
bits = randi([0,1], num_bits, 1);

% Pair bits and map to QPSK symbols
bit_pairs = reshape(bits, 2, num_bits/2).';

% Map symbols to I and Q directly 
% 0 -> ( +1, +1)
% 1 -> (+1, -1)  
% 2 -> (-1,+1)
% 3 -> (-1,-1)
I_symbols = 1 - 2*bit_pairs(:,1);   % bit=0 -> +1, bit=1 -> -1
Q_symbols = 1 - 2*bit_pairs(:,2);   % bit=0 -> +1, bit=1 -> -1

% Upsample
I_up = zeros(length(I_symbols)*samples_per_symbol, 1);
Q_up = zeros(length(Q_symbols)*samples_per_symbol, 1);
I_up(1:samples_per_symbol:end) = I_symbols;
Q_up(1:samples_per_symbol:end) = Q_symbols;

% Pulse shape with RRC Filter
I_shaped = conv(I_up, h_rrc, 'same');
Q_shaped = conv(Q_up, h_rrc, 'same');

% Create time vector and carriers
N = length(I_up);
t = (0:N-1).' / fs;
carrier_cos = cos(2*pi*f_carrier*t);
carrier_sin = sin(2*pi*f_carrier*t);

% Modulate
tx_wave = I_shaped.*carrier_cos - Q_shaped.*carrier_sin;

% Plot transmitter
figure;
subplot(2,1,1);
plot(t(1:100)*1e6, tx_wave(1:100), 'b');
title('Transmitted Wave'); xlabel('Time (us)'); grid on;

subplot(2,1,2);
plot(I_symbols, Q_symbols, 'ro', 'MarkerFaceColor', 'r');
axis([-2 2 -2 2]); grid on;
title('Transmitted Constellation');
xlabel('I'); ylabel('Q');

%% PHASE 2: CHANNEL

% ---- Link Budget ----
c_speed = 3e8;
f_rf    = 12e9;

% Geometery: slant range from elevation angle (GEO satellite)
Re        = 6378e3;
h_geo     = 35786e3;
elev_deg  = 40;
d_satellite = -Re*sind(elev_deg) + sqrt((Re*sind(elev_deg))^2 + h_geo^2 + 2*Re*h_geo);

% Transmit side
tx_power_dBW = 17;
tx_antenna_gain_dB = 30;
rx_antenna_gain_dB = 40;
EIRP_dBW = tx_power_dBW + tx_antenna_gain_dB;

% Losses, listed separately
rain_loss_dB = 0;
gas_loss_dB = 0.2;
pointing_loss_dB = 0.5;
pol_loss_dB = 0.3;
impl_loss_dB = 1.5;
fspl_dB = 20*log10(4*pi*d_satellite*f_rf/c_speed);
total_loss_dB = fspl_dB + rain_loss_dB + gas_loss_dB + pointing_loss_dB + pol_loss_dB;
total_gain_dB = EIRP_dBW +rx_antenna_gain_dB;
Prx_dBW = total_gain_dB - total_loss_dB;

% Noise
k = 1.38e-23;
T_sys_clear = 150;
T_rain_phys = 275;
T_rain = T_rain_phys * (1 - 10^(-rain_loss_dB/10));
T_sys = T_sys_clear + T_rain;
GT_dBK = rx_antenna_gain_dB - 10*log10(T_sys);

Rs = fs/samples_per_symbol;
Rb = 2*Rs;
Eb_N0_dB = Prx_dBW - 10*log10(k*T_sys*Rb);
Eb_N0_lin = 10^(Eb_N0_dB/10);

% Margin against uncoded QPSK at BER = 1e-5 
required_EbN0_dB = 9.6;
link_margin_dB = Eb_N0_dB - impl_loss_dB - required_EbN0_dB;


% --- Signal: scale unit-power waveform to the received power from the budget
P_rx_W     = 10^(Prx_dBW/10);                     % received power in watts
tx_unit    = tx_wave / sqrt(mean(tx_wave.^2));    % normalise to unit power
faded_wave = tx_unit * sqrt(P_rx_W * impedance);  % volt across 50 ohm

% --- Noise: thermal noise from kTB over the simulated bandwidth
B_sim     = fs/2;
noise_var = k * T_sys * B_sim * impedance;
noise     = sqrt(noise_var) * randn(N, 1);
rx_wave   = faded_wave + noise;

% --- Measured values from the actual waveforms
Ps_meas = mean(faded_wave .^2) / impedance;
Pn_meas = mean(noise .^2) / impedance;
N0_meas = Pn_meas / B_sim;
Eb_N0_meas_lin = (Ps_meas / Rb) / N0_meas;
Eb_N0_meas_dB = 10*log10(Eb_N0_meas_lin);
Eb_N0_meas_dB = Es_N0_meas_dB + 10*log10(2);
CN0_dBHz = 10*log10(Ps_meas / N0_meas);
SNR_dB = 10*log10(Ps_meas / Pn_meas);

fprintf('Budget Eb/N0: %.2f dB\n', Eb_N0_dB);
fprintf('Measured Eb/N0: %.2f dB\n', Eb_N0_meas_dB);

% Plot channel
figure;
subplot(2,1,1);
plot(t(1:100)*1e6, faded_wave(1:100), 'k');
title(sprintf('After %.1f dB Path Loss', total_loss_dB)); grid on;

subplot(2,1,2);
plot(t(1:100)*1e6, rx_wave(1:100), 'r');
title(sprintf('Received Signal + Noise | SNR=%.1f dB | Eb/N0=%.1f dB', SNR_dB, Eb_N0_meas_dB));
grid on;

%% PHASE 3: RECEIVER

% Demodulate
theta = phase_offset_deg*pi/180;
cos_rx = cos(2*pi*(f_carrier + freq_offset_Hz)*t + theta);
sin_rx = sin(2*pi*(f_carrier + freq_offset_Hz)*t + theta);
I_dem =  rx_wave .* cos_rx;
Q_dem = -rx_wave .* sin_rx;

% Matched RRC Filter
I_matched = conv(I_dem, h_rrc, 'same');
Q_matched = conv(Q_dem, h_rrc, 'same');
I_filt = I_matched(1 : samples_per_symbol : end);
Q_filt = Q_matched(1 : samples_per_symbol : end);

% Normalise (the signal is in tiny volts)
scale = mean(abs([I_filt; Q_filt]));
z     = (I_filt + 1j*Q_filt) / scale;

% --- Costas Loop for QPSK (second order) ---
alpha = 0.10;
beta_1 = 0.005;
ph = 0;  fr = 0;
nsym = length(z);
y = zeros(nsym, 1);
ph_track = zeros(nsym, 1);
for n = 1:nsym
    y(n) = z(n) * exp(-1j*ph);
    err = sign(real(y(n)))*imag(y(n)) - sign(imag(y(n)))*real(y(n));
    fr = fr + beta_1*err;
    ph = ph + fr+ alpha*err;
    ph_track(n) = ph;
end

I_rec = real(y);
Q_rec = imag(y);

% Decisions
recovered_bits = zeros(num_bits, 1);
recovered_bits(1:2:end) = (I_rec < 0);
recovered_bits(2:2:end) = (Q_rec < 0);

% Count errors after the loop has locked
first_bit = 2*skip_sym + 1;
count_bits = (num_bits - 6) - first_bit + 1;
num_errors = sum(bits(first_bit:end-6) ~= recovered_bits(first_bit:end-6));
BER_simulated = num_errors / count_bits;

% Plot: before and after the Costas Loop
figure;
subplot(1, 2, 1);
plot(real(z(skip_sym:end)), imag(z(skip_sym:end)), 'r.');
hold on;  plot([0 0], [-2 2], 'k--');    plot([-2 2], [0 0], 'k--');
axis([-2 2 -2 2]); grid on;  axis square;
title(sprintf('Before Costas (offset %d deg)', phase_offset_deg);
xlabel('I');  ylabel('Q');

subplot(1, 2, 2);
plot(real(z(skip_sym:end)), imag(z(skip_sym:end)), 'b.');
hold on;  plot([0 0], [-2 2], 'k--');    plot([-2 2], [0 0], 'k--');
axis([-2 2 -2 2]); grid on;  axis square;
title(sprintf('After Costas | Eb/N0 = %.1f dB | BER = %.2e', Eb_N0_meas_dB, BER_simulated));
xlabel('I');  ylabel('Q');

% Phase estimate over time
figure;
plot(ph_track*180/pi);  grid on;
xlabel('Symbol');  ylabel('Estimated Phase (deg)');
title('Costas loop phase estimate');

%% PHASE 4: BER CURVE

Eb_N0_range_dB = 0:1:8;
BER_sim     = nan(size9Eb_N0_range_dB));
target_errros = 100;
chunk_bits = 20000;
max_bits = 2e6;

for idx = 1:length(Eb_N0_range_dB)
    en = 10^(Eb_N0_range_dB(idx)/10);
    total_errors = 0;
    total_bits = 0;

while total_errors < target_errors && total_bits < max_bits
nsym = chunk_bits/2;

b = randi([0,1], chunk_bits, 1);
bp = reshape(b, 2, nsym);
I_s = 1 - 2*bp(:,1);
Q_s = 1 - 2*bp(:,2);

I_u = zeros(nysm*samples_per_symbol, 1);  I_u(1:samples_per_symbol:end)
Q_u = zeros(nysm*samples_per_symbol, 1);  Q_u(1:samples_per_symbol:end)
I_sh = conv(I_u, h_rrc, 'same');
Q_sh = conv(Q_u, h_rcc, 'same');

tt = (0:length(I_u)-1).' / fs;
cc = cos(2*pi*f_carrier*tt);
ss = sin(2*pi*f_carrier*tt);
tx = I_sh.*cc - Q_sh.*ss;

% Noise set from the Eb/N0 being swept
sp = mean(tx.^2);
nv = sp * fs / (2 * Rb * en);
rx = tx + sqrt(nv)*randn(size(tx));

Id = rx.*cc;
Qd = -rx.*ss;
Im = conv(Id, h_rrc, 'same');
Qm = conv(Qd, h_rrc, 'same');
If = Im(1:samples_per_symbol:end);
Qf = Qm(1:samples_per_symbol:end);

rb = zeros(chunk_bits, 1);
rb(1:2:end) = (If < 0);
rb(2:2:end) = (Qf < 0);

% Ignore first and last 6 bits (filter edge effects)
total_errors = total_errors + sum(b(7:end-6) ~= rb(7:end-6));
total_bits = total_bits + (chunk_bits - 12);
end

if total_erros > 0
    BER_sim(idx) = total_errors / total_bits;
 end
end

% Theory on a fine grid, extended to cover the operating point
EbN0_fine = 0:0.25:15;
BER_theory = 0.5*erfc(sqrt(10.^(EbN0_fine/10)));
BER_op = 0.5*erfc(sqrt(Eb_N0_meas_lin));

figure;
semilogy(EbN0_fine, BER_theory, 'b-', 'LineWidth', 2);
hold on;
semilogy(Eb_No_range_dB, BER_sim, 'ro', 'MarkerFaceColor', 'r');
semilogy(Eb_N0_meas_dB, BER_op, 'ks', 'MarkerFaceColor', 'g', MarkerSize', 10);
grid on;
xlabel('Eb/N0 (dB)');
ylabel('BER');
title('BER vs Eb/N0; QPSK Simulation vs Theory');
legend('Theory', 'Simulation (>=100 errors/point)', ...
    sprintf('Link operating point (theory BER = %.1e)', BER_op), ...
    'Location', 'southwest');
ylim([1e-9 1]);
   
%% RESULTS
fprintf('\n=== SATELLITE LINK RESULTS ===\n');
fprintf('Slant range:     %.0f km\n', d_satellite/1e3);
fprintf('EIRP:            %.2f dBW\n', EIRP_dBW);
fprintf('FSPL:            %.2f dB\n', fspl_db);
fprintf('Total Loss:      %.2f dB\n', total_loss_db);
fprintf('Prx:             %.2f dBW\n', Prx_dBW);
fprintf('G/T:             %.2f dB/K\n', GT_dBK);
fprintf('C/N0:            %.2f dB-Hz\n', CN0_dBHz);
fprintf('Eb/N0 (budget):  %.2f dB\n', Eb_No_dB);
fprintf('Eb/N0 (sim):     %.2f dB\n', Eb_N0_meas_dB);
fprintf('Link Margin:     %.2f dB\n', uncoded QPSK, BER 1e-5, incl. %.1f dB impl. loss)\n', link_margin_dB, impl_loss_dB);
fprintf('Bits Counted:    %d\n', count_bits);
fprintf('Errors:          %d\n', num_errors);
fprintf('Simulated BER:   %.2e (0 error is expected at this Eb/N0)\n', BER_simulated);
fprintf('Theoretical BER: %.2e\n', 0.5*erfc(sqrt(10^(Eb_N0_meas_dB/10))));
fprintf('==============================\n');

